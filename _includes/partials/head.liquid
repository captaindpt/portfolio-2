<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if title and title != "Home" %}{{ title }} — {{ site.author }}{% else %}{{ site.author }}{% endif %}</title>
<meta name="description" content="{{ description | default: site.description }}">
<meta name="author" content="{{ site.author }}">

<link rel="icon" type="image/png" href="/assets/logo.png">
<link rel="apple-touch-icon" href="/assets/logo.png">

<link rel="preload" href="/assets/fonts/TestMartinaPlantijn-Light-BF663c36d1dbbe7.otf" as="font" type="font/otf" crossorigin>
<link rel="preload" href="/assets/fonts/TestMartinaPlantijn-Regular-BF663c36d1ec6d5.otf" as="font" type="font/otf" crossorigin>
<link rel="preload" href="/assets/fonts/new-fonts/TX-02-Variable.woff2" as="font" type="font/woff2" crossorigin>

<!-- Theme before paint: saved preference wins, else system -->
<script>
(function () {
    var forced = new URLSearchParams(location.search).get('theme');
    var saved = forced || localStorage.getItem('theme');
    var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (dark) document.documentElement.classList.add('dark');
})();
</script>

<link rel="stylesheet" href="/css/style.css">

<!-- Syntax highlighting for posts -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism.min.css" rel="stylesheet">
